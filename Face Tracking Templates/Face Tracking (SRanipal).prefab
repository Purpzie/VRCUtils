        faceTrackingParameterBehaviors:
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Jaw_Open
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (JawOpen * (1 - TongueOut / 4) + TongueOut / 4) * (1
            - MouthClosed)
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Jaw_Forward
          weightBlendSetName: Lips
          inputTrackingKeys: 270000002b000000
          inputTrackingKeyNames:
          - JawForward
          - MouthClosed
          inputInverted: 0001
          combineMode: 3
          customExpression: 
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Jaw_Left
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: JawLeft * (1 - abs((MouthUpperRight + MouthLowerRight
            - MouthUpperLeft - MouthLowerLeft) / 4))
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Jaw_Right
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: JawRight * (1 - abs((MouthUpperRight + MouthLowerRight
            - MouthUpperLeft - MouthLowerLeft) / 4))
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Sad_Left
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: max(0, max(MouthFrownLeft, MouthStretchLeft) - MouthCornerPullLeft
            * 0.8 - MouthCornerSlantLeft * 0.2) * (1 - (MouthUpperLeft + MouthLowerLeft)
            / 2)
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Sad_Right
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: max(0, max(MouthFrownRight, MouthStretchRight) - MouthCornerPullRight
            * 0.8 - MouthCornerSlantRight * 0.2) * (1 - (MouthUpperRight + MouthLowerRight)
            / 2)
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Pout
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: ((LipPuckerUpperRight + LipPuckerUpperLeft + LipPuckerLowerRight
            + LipPuckerLowerLeft) / 4) * (1 - ((LipFunnelUpperLeft + LipFunnelUpperRight
            + LipFunnelLowerLeft + LipFunnelLowerRight) / 4))
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Ape_Shape
          weightBlendSetName: Lips
          inputTrackingKeys: 2b00000024000000
          inputTrackingKeyNames:
          - MouthClosed
          - JawOpen
          inputInverted: 0000
          combineMode: 3
          customExpression: 
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Eye_Left_Constrict
          weightBlendSetName: Eyes
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (EyeWideLeft + EyeWideRight + EyeConstrictLeft + EyeConstrictRight)
            / 2
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Eye_Right_Constrict
          weightBlendSetName: Eyes
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (EyeWideLeft + EyeWideRight + EyeConstrictLeft + EyeConstrictRight)
            / 2
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Eye_Left_Dilation
          weightBlendSetName: Eyes
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (MouthFrownLeft + MouthFrownRight - EyeWideLeft - EyeWideRight
            + EyeDilationLeft + EyeDilationRight) / 2
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Eye_Right_Dilation
          weightBlendSetName: Eyes
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (MouthFrownLeft + MouthFrownRight - EyeWideLeft - EyeWideRight
            + EyeDilationLeft + EyeDilationRight) / 2
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Lower_Overlay
          weightBlendSetName: Lips
          inputTrackingKeys: 510000002b000000
          inputTrackingKeyNames:
          - MouthRaiserLower
          - MouthClosed
          inputInverted: 0001
          combineMode: 3
          customExpression: 
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Upper_Up_Right
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthUpperUpRight + ((LipFunnelUpperLeft + LipFunnelUpperRight
            + LipFunnelLowerLeft + LipFunnelLowerRight) / 4) * (1 - MouthUpperUpRight)
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Upper_Up_Left
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthUpperUpLeft + ((LipFunnelUpperLeft + LipFunnelUpperRight
            + LipFunnelLowerLeft + LipFunnelLowerRight) / 4) * (1 - MouthUpperUpLeft)
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Lower_DownLeft
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (MouthLowerDownLeft + MouthLowerDownRight) / 2 + ((LipFunnelUpperLeft
            + LipFunnelUpperRight + LipFunnelLowerLeft + LipFunnelLowerRight) / 4)
            * (1 - (MouthLowerDownLeft + MouthLowerDownRight) / 2)
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Lower_DownRight
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (MouthLowerDownLeft + MouthLowerDownRight) / 2 + ((LipFunnelUpperLeft
            + LipFunnelUpperRight + LipFunnelLowerLeft + LipFunnelLowerRight) / 4)
            * (1 - (MouthLowerDownLeft + MouthLowerDownRight) / 2)
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Lower_Overturn
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (LipFunnelUpperLeft + LipFunnelUpperRight + LipFunnelLowerLeft
            + LipFunnelLowerRight) / 4
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Upper_Overturn
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (LipFunnelUpperLeft + LipFunnelUpperRight + LipFunnelLowerLeft
            + LipFunnelLowerRight) / 4
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Upper_Inside
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (LipSuckUpperLeft + LipSuckUpperRight) / 2
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Lower_Inside
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (LipSuckLowerRight + LipSuckLowerLeft) / 2
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Smile_Left
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthCornerPullLeft * 0.8 + MouthCornerSlantLeft * 0.2
            - max(MouthFrownLeft, MouthStretchLeft)
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Smile_Right
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthCornerPullRight * 0.8 + MouthCornerSlantRight *
            0.2 - max(MouthFrownRight, MouthStretchRight)
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Lower_Left
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (MouthUpperLeft + MouthLowerLeft) / 2
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Upper_Left
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (MouthUpperLeft + MouthLowerLeft) / 2
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Upper_Right
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (MouthUpperRight + MouthLowerRight) / 2
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Lower_Right
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (MouthUpperRight + MouthLowerRight) / 2
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Cheek_Suck
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (CheekSuckLeft + CheekSuckRight) / 1.4
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Tongue_LongStep1
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: TongueOut * 2 * (1 - (LipFunnelUpperLeft + LipFunnelUpperRight
            + LipFunnelLowerLeft + LipFunnelLowerRight) / 2.8)
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Tongue_LongStep2
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (TongueOut - 0.5) * 2 * (1 - (LipFunnelUpperLeft + LipFunnelUpperRight
            + LipFunnelLowerLeft + LipFunnelLowerRight) / 2.8)
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Tongue_UpRight_Morph
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (TongueUp * TongueRight) / 0.7
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Tongue_UpLeft_Morph
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (TongueUp * TongueLeft) / 0.7
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Tongue_DownRight_Morph
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (TongueDown * TongueRight) / 0.7
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Tongue_DownLeft_Morph
          weightBlendSetName: Lips
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (TongueDown * TongueLeft) / 0.7
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Eye_Left_Blink
          weightBlendSetName: Eyes
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: EyeClosedLeft * (1 + EyeSquintLeft / 3) + EyeSquintLeft
            * 0.666
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Eye_Right_Blink
          weightBlendSetName: Eyes
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: EyeClosedRight * (1 + EyeSquintRight / 3) + EyeSquintRight
            * 0.666
